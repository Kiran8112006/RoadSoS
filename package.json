{
  "name": "roadsos",
  "version": "1.0.0",
  "description": "RoadSoS - Road Safety and Occupant Security system",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "install-all": "npm install",
    "backend": "npm --prefix backend",
    "frontend": "npm --prefix frontend",
    "dev": "npm run start --workspace=backend & npm run start --workspace=frontend",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "expo": "~54.0.34",
    "react": "19.1.0",
    "react-native": "0.81.5"
  }
}
